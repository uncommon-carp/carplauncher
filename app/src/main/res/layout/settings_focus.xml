<?xml version="1.0" encoding="utf-8"?>
<!-- Focus settings card. Included from fragment_settings.xml, bound by FocusSettingsController. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/rounded_rect_shade_color"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="16dp">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/focus"
        android:textColor="?attr/primaryColor" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/frequent_apps_on_home"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/frequentAppsNum"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="4" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/frequent_apps_window"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/frequentAppsWindow"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            tools:text="7 days" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/auto_launch_single_match"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/autoLaunchSingleMatch"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            tools:text="On" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/modes"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/modes"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="Work" />
    </FrameLayout>

    <TextView
        style="@style/TextSmallLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="@string/modes_note"
        android:textSize="12sp" />

    <TextView
        style="@style/TextSmallLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="20dp"
        android:text="@string/friction_scope_note"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/distracting_apps"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/distractingApps"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="2" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/friction_delay"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/frictionDelay"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="10 s" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/friction_ask_why"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/frictionAskWhy"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="Off" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:paddingVertical="8dp"
            android:text="@string/friction_daily_cap"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/frictionDailyCap"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:paddingVertical="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            tools:text="Off" />
    </FrameLayout>

    <TextView
        style="@style/TextSmallLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="12dp"
        android:text="@string/focus_tracking_note"
        android:textSize="12sp" />

</LinearLayout>
